#!/usr/bin/env python3
"""Compatibility entry point for packaged esp32 commands."""
from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parents[1]
if (ROOT / 'python/ros2android').is_dir():
    sys.path.insert(0, str(ROOT / 'python'))

from ros2android.esp32 import esptool_version, relay, run  # noqa: E402,F401


def main():
    return run()


if __name__ == '__main__':
    raise SystemExit(main())
