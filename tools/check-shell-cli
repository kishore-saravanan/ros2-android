#!/usr/bin/env python3
"""Verify all bundled ROS CLI command/verb imports on the connected Android runner."""
import argparse
import json
from pathlib import Path
import subprocess

ROOT = Path(__file__).resolve().parents[1]


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--workspace', default='examples/android_test_ws')
    parser.add_argument('--id')
    parser.add_argument('--serial')
    args = parser.parse_args()
    lock = json.loads((ROOT / 'native/ros-shell-packages.lock.json').read_text())
    commands = sorted(name[4:] for name in lock['rosPackages'] if name.startswith('ros2') and name != 'ros2cli')
    script = '''import importlib.metadata as metadata
import json, subprocess
commands = COMMANDS
failures = []
checks = []
for command in commands:
    checks.append([command, '--help'])
    checks.extend([command, ep.name, '--help'] for ep in metadata.entry_points(group='ros2' + command + '.verb'))
for args in checks:
    process = subprocess.run(['ros2', *args], capture_output=True, text=True, timeout=20)
    if process.returncode or 'Failed to load entry point' in process.stderr or 'Traceback' in process.stderr:
        failures.append({'args': args, 'exit': process.returncode, 'stderr': process.stderr[-3000:]})
print(json.dumps({'commands': commands, 'checks': len(checks), 'failures': failures}, indent=2))
raise SystemExit(bool(failures))
'''.replace('COMMANDS', repr(commands))
    command = [str(ROOT / 'tools/connect-shell'), '--workspace', args.workspace]
    for key in ('id', 'serial'):
        value = getattr(args, key)
        if value: command += ['--' + key, value]
    return subprocess.run([*command, '--', 'python3', '-c', script]).returncode


if __name__ == '__main__':
    raise SystemExit(main())
