#!/usr/bin/env python3
"""Compatibility entry point for the packaged workspace command."""

from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parents[1]
if (ROOT / 'python/ros2android').is_dir():
    sys.path.insert(0, str(ROOT / 'python'))

from ros2android.workspace import digest_tree, elf_check, inventory, stage, run  # noqa: E402,F401


def main():
    return run(tooling_root=ROOT)


if __name__ == '__main__':
    raise SystemExit(main())
