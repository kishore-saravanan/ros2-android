#!/usr/bin/env bash
# Isolated simulator environment; no system/phone appearance or graphics changes.
set -euo pipefail
project_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
pc_interface=""

if [[ "${1:-}" == --interface ]]; then
    pc_interface="${2:?Missing IPv4}"
    shift 2
fi

if [[ -z "$pc_interface" ]]; then
    route_source='import json, sys; print(json.load(sys.stdin)[0]["prefsrc"])'
    pc_interface="$(ip -j route get 1.1.1.1 | python3 -c "$route_source")"
fi

check_ipv4='import ipaddress, sys; print(ipaddress.IPv4Address(sys.argv[1]))'
pc_interface="$(python3 -c "$check_ipv4" "$pc_interface")"
export ROS_DOMAIN_ID="${ROS_DOMAIN_ID:-0}"
interfaces="<Interfaces><NetworkInterface address=\"$pc_interface\"/></Interfaces>"
discovery='<ParticipantIndex>auto</ParticipantIndex>'
discovery+='<MaxAutoParticipantIndex>120</MaxAutoParticipantIndex>'
domain="<General>$interfaces</General><Discovery>$discovery</Discovery>"
export CYCLONEDDS_URI="<CycloneDDS><Domain>$domain</Domain></CycloneDDS>"
export GZ_PARTITION=ros2android_dashboard_stable
demo="$project_root/examples/turtlebot4_dashboard"
pc_ros="$project_root/tools/pc-ros.sh"

case "${1:-start}" in
    start)
        mkdir -p "$HOME/.cache/ros2-android-demo"
        cp "$demo/world.sdf" "$HOME/.cache/ros2-android-demo/dashboard-world.sdf"
        export QT_QPA_PLATFORM=xcb QT_XCB_GL_INTEGRATION=xcb_glx

        # Use NVIDIA only when the installed GLVND vendor is available.
        if [[ -f /usr/share/glvnd/egl_vendor.d/10_nvidia.json ]]; then
            export __GLX_VENDOR_LIBRARY_NAME=nvidia
            export __EGL_VENDOR_LIBRARY_FILENAMES=/usr/share/glvnd/egl_vendor.d/10_nvidia.json
        fi

        exec "$pc_ros" -- ros2 launch "$demo/demo.launch.py"
        ;;
    telemetry)
        exec "$pc_ros" -- python3 "$project_root/tools/turtlebot4-dashboard-telemetry.py"
        ;;
    undock)
        exec "$pc_ros" -- ros2 action send_goal \
            /tb4_demo/undock irobot_create_msgs/action/Undock '{}'
        ;;
    ros)
        shift
        exec "$pc_ros" -- ros2 "$@"
        ;;
    *)
        printf 'Usage: %s [--interface PC_IPV4] {start|telemetry|undock|ros ARGS...}\n' "$0" >&2
        exit 2
        ;;
esac
