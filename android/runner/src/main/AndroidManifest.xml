<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <application android:icon="@mipmap/ic_launcher_ros2" android:roundIcon="@mipmap/ic_launcher_ros2" android:allowBackup="false" android:label="ROS2 Android · ${runnerProjectId}" android:theme="@style/RunnerTheme">
        <service android:name=".ProjectControlService" android:exported="true" android:permission="dev.ros2android.android.MANAGE_PROJECTS" />
        <service android:name=".ProjectService" android:exported="false" android:foregroundServiceType="connectedDevice" />
        <activity android:name=".MainActivity" android:exported="true">
            <meta-data android:name="dev.ros2android.PROJECT_PROTOCOL" android:value="1" />
            <meta-data android:name="dev.ros2android.PROJECT_ID" android:value="${runnerProjectId}" />
            <meta-data android:name="dev.ros2android.PROJECT_RUNTIME" android:value="${runnerRuntime}" />
            <meta-data android:name="dev.ros2android.PROJECT_SOURCE" android:value="sha256:${runnerSourceId}" />
            <intent-filter>
                <action android:name="dev.ros2android.android.OPEN_PROJECT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
